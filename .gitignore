# Build artifacts
/build/
/build-release/
/release/
/vcpkg_installed/
**/CMakeUserPresets.json
build_log.txt

# Single-file launcher payload: a zip of the packaged program, regenerated by
# release.bat every build (see CMakeLists.txt's "launcher target" section).
launcher/payload.zip

# Test scratch dirs
.s*test/
.guitest/

# IDE
.vs/
*.user

# Runtime bundles the user drops in (copyrighted / large / third-party
# redistributables); keep the READMEs that explain the folders, ignore the
# binaries. See the "Optional runtime bundles" section in README.md.
# resources/runtime/ = deprecated, superseded by runtime/ below.
resources/runtime/*
!resources/runtime/README.md
# runtime/ = Mod Loader runtime, embedded into GMM.exe at build time.
runtime/*
!runtime/README.md
# runtime-samp/ = a full official SA-MP client install, embedded the same way.
runtime-samp/*
!runtime-samp/README.md
# runtime-steam/ = Valve's steam_api64.dll, loaded at runtime for the Steam
# "in-game" status. Optional: normally borrowed from an installed Steam game.
runtime-steam/*
!runtime-steam/README.md

# Logs
*.log

# OS
Thumbs.db
desktop.ini

